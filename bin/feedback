#!/usr/bin/env python3
import os
import json
import argparse
from pathlib import Path
import chromadb
import dspy
from dspy.retrieve.chromadb_rm import ChromadbRM
from typing import List, Dict, Set
import subprocess
import time
import logging

# Constants
DEFAULT_ROOT = os.path.expanduser("~/.swechainagent")
DEFAULT_ENV = "swechainblocks"
DEFAULT_LLM = "llama3"  # Using native Ollama model name
DEFAULT_RETRIEVAL_COUNT = 3
PAGE_LIMIT = 50
MAX_PAGES = 7
REQUEST_DELAY = 0.5
SWECHAIND_PATH = os.environ.get("SWECHAIND_PATH", "/home/maf/go/bin/swechaind")

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)

# Initialize DSPy with Ollama directly
#llm = dspy.OllamaLocal(model=DEFAULT_LLM)
#llm = dspy.LM('ollama_chat/llama3.2:3b-instruct-fp16', api_base='http://localhost:11434', api_key='')
llm = dspy.LM('ollama_chat/deepseek-r1:1.5b', api_base='http://localhost:11434', api_key='')
dspy.settings.configure(lm=llm)

class BlockQASignature(dspy.Signature):
    """Signature for block-based question answering"""
    context = dspy.InputField(desc="Relevant block data as text")
    question = dspy.InputField(desc="Question about the block")
    answer = dspy.OutputField(desc="Answer derived from the context")

class CosmosBlockFetcher:
    def __init__(self, swechaind_path: str = SWECHAIND_PATH):
        self.swechaind_path = swechaind_path
        if not os.path.exists(self.swechaind_path):
            logger.warning(f"swechaind not found at {self.swechaind_path}")

    def get_all_blocks(self) -> List[Dict]:
        """Paginate through all blocks using swechaind CLI"""
        blocks = []
        seen_heights = set()
        
        for page in range(1, MAX_PAGES + 1):
            page_blocks = self._get_block_page(page)
            if not page_blocks:
                break
                
            for block in page_blocks:
                height = int(block['header']['height'])
                if height not in seen_heights:
                    blocks.append(block)
                    seen_heights.add(height)
            
            time.sleep(REQUEST_DELAY)
        
        return sorted(blocks, key=lambda b: int(b['header']['height']))

    def _get_block_page(self, page: int) -> List[Dict]:
        """Get one page of blocks"""
        try:
            cmd = [
                self.swechaind_path, "query", "txs",
                "--query", "tx.height>0",
                "--output", "json",
                "--page", str(page),
                "--limit", str(PAGE_LIMIT)
            ]
            result = subprocess.run(
                cmd,
                check=True,
                capture_output=True,
                text=True
            )
            return self._parse_tx_response(result.stdout)
        except subprocess.CalledProcessError as e:
            logger.error(f"Error fetching page {page}: {e.stderr}")
            return []
        except FileNotFoundError:
            logger.error(f"swechaind not found at {self.swechaind_path}")
            return []

    def _parse_tx_response(self, json_str: str) -> List[Dict]:
        """Convert tx response to block format"""
        try:
            data = json.loads(json_str)
            txs = data if isinstance(data, list) else data.get('txs', [])
            
            blocks = {}
            for tx in txs:
                if not isinstance(tx, dict):
                    continue
                    
                height = int(tx.get('height', 0))
                if height <= 0:
                    continue
                
                if height not in blocks:
                    blocks[height] = {
                        "header": {
                            "height": str(height),
                            "time": tx.get('timestamp', ''),
                            "chain_id": tx.get('chain_id', '')
                        },
                        "data": {
                            "txs": [],
                            "tx_count": 0
                        },
                        "txs": []
                    }
                
                blocks[height]["data"]["txs"].append(tx)
                blocks[height]["data"]["tx_count"] += 1
                blocks[height]["txs"].append(tx)
            
            return list(blocks.values())
        except json.JSONDecodeError as e:
            logger.error(f"Error parsing response: {e}")
            return []

class SwechainConfig:
    def __init__(self, env_name: str = DEFAULT_ENV):
        self.root_path = Path(DEFAULT_ROOT)
        self.env_name = env_name
        self.env_path = self.root_path / env_name
        self.chroma_path = self.root_path / "chromadb"
        self._ensure_dirs()

    def _ensure_dirs(self):
        """Create required directories"""
        self.env_path.mkdir(parents=True, exist_ok=True)
        self.chroma_path.mkdir(parents=True, exist_ok=True)

    def get_block_path(self, height: int) -> Path:
        return self.env_path / f"block_{height}.txt"

    def get_indexed_heights(self) -> Set[int]:
        """Get set of already indexed block heights"""
        heights = set()
        for f in self.env_path.glob("block_*.txt"):
            try:
                heights.add(int(f.stem.split('_')[1]))
            except (ValueError, IndexError):
                continue
        return heights

class BlockRetriever(dspy.Module):
    def __init__(self, retrieval_count: int = DEFAULT_RETRIEVAL_COUNT):
        super().__init__()
        self.retriever = None
        self.retrieval_count = retrieval_count
        
    def forward(self, question: str) -> List[str]:
        results = self.retriever(question, k=self.retrieval_count)
        return [str(r) for r in results]

class SwechainAgent:
    def __init__(self, config: SwechainConfig, swechaind_path: str = SWECHAIND_PATH):
        self.config = config
        self.retriever = BlockRetriever()
        self.predict = dspy.Predict(BlockQASignature)
        self.block_fetcher = CosmosBlockFetcher(swechaind_path)
        
        # Initialize retriever
        self.retriever.retriever = ChromadbRM(
            collection_name=self.config.env_name,
            persist_directory=str(self.config.chroma_path),
            k=DEFAULT_RETRIEVAL_COUNT
        )

    def _format_block(self, block: Dict) -> str:
        """Format block data for storage"""
        header = block.get("header", {})
        txs = block.get("data", {}).get("txs", [])
        
        formatted = [
            f"Block Height: {header.get('height', 'N/A')}",
            f"Timestamp: {header.get('time', 'N/A')}",
            f"Chain ID: {header.get('chain_id', 'N/A')}",
            f"Transaction Count: {len(txs)}",
            "Transactions:"
        ]
        
        for i, tx in enumerate(txs, 1):
            formatted.extend([
                f"\nTransaction {i}:",
                f"Hash: {tx.get('txhash', 'N/A')}",
                f"Messages: {len(tx.get('messages', []))}",
                f"Fee: {json.dumps(tx.get('fee', {}), indent=2)}"
            ])
        
        return "\n".join(formatted)

    def update_blocks(self) -> int:
        """Fetch and index new blocks"""
        try:
            client = chromadb.PersistentClient(path=str(self.config.chroma_path))
            collection = client.get_or_create_collection(name=self.config.env_name)
            
            indexed_heights = self.config.get_indexed_heights()
            logger.info(f"Found {len(indexed_heights)} already indexed blocks")
            
            logger.info("Fetching all blocks via swechaind CLI...")
            blocks = self.block_fetcher.get_all_blocks()
            logger.info(f"Retrieved {len(blocks)} blocks from chain")
            
            new_blocks = 0
            for block in blocks:
                height = int(block['header']['height'])
                if height in indexed_heights:
                    continue
                
                block_text = self._format_block(block)
                
                with open(self.config.get_block_path(height), 'w') as f:
                    f.write(block_text)
                
                collection.add(
                    documents=[block_text],
                    ids=[f"block_{height}"],
                    metadatas=[{"height": height}]
                )
                new_blocks += 1
            
            logger.info(f"Indexed {new_blocks} new blocks total")
            return new_blocks
        except Exception as e:
            logger.error(f"Error updating blocks: {e}")
            return 0

    def infer(self, query: str, update_first: bool = True) -> str:
        """Run inference using RAG pipeline"""
        try:
            if update_first:
                logger.info("Updating block data...")
                self.update_blocks()
            
            logger.info(f"Processing query: {query}")
            
            # Retrieve relevant blocks
            contexts = self.retriever(query)
            
            if not contexts:
                return "No relevant blocks found to answer the question"
            
            # Generate answer using the context
            result = self.predict(
                context="\n\n".join(contexts),
                question=query
            )
            
            return result.answer
        except Exception as e:
            logger.error(f"Inference error: {e}")
            return f"Error during inference: {str(e)}"

def main():
    parser = argparse.ArgumentParser(
        description="SwechainAgent RAG System",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        "--mode",
        required=True,
        choices=["train", "infer"],
        help="Operation mode"
    )
    parser.add_argument(
        "--query",
        help="Query text (required for infer)"
    )
    parser.add_argument(
        "--no-update",
        action="store_true",
        help="Skip updating blocks before inference"
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose logging"
    )
    
    args = parser.parse_args()

    try:
        if args.verbose:
            logger.setLevel(logging.DEBUG)
        
        config = SwechainConfig()
        agent = SwechainAgent(config)
        
        if args.mode == "train":
            agent.update_blocks()
        elif args.mode == "infer":
            if not args.query:
                parser.error("--query required for inference")
                
            response = agent.infer(
                args.query,
                update_first=not args.no_update
            )
            print("\nResponse:", response)
    except Exception as e:
        logger.error(f"Fatal error: {e}")
        exit(1)

if __name__ == "__main__":
    main()
